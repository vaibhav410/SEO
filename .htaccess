# SYSCOM GrowthHub - Apache configuration (requires mod_rewrite; AllowOverride All)

Options -Indexes -MultiViews
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS in production (uncomment once an SSL certificate is installed)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block private application folders and sensitive file types
    RewriteRule ^(config|includes|modules|pages|database|storage|tests|docs|docker|vercel)(/|$) - [F,L]
    RewriteRule ^admin/partials(/|$) - [F,L]
    RewriteRule ^(Dockerfile|render\.yaml)$ - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule \.(sql|md|log|ini|sh)$ - [F,L]

    # Dynamic robots.txt and XML sitemap
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Everything that is not a real file or folder goes to the front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>


<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header unset X-Powered-By
    <FilesMatch "\.(css|js|png|jpe?g|webp|svg|ico|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
